model Appointment {
  id              String            @id @default(uuid())
  userId          String
  doctorId        String
  date            DateTime          @db.Date
  startTime       String
  endTime         String
  status          AppointmentStatus @default(PENDING_PAYMENT)
  forSelf         Boolean           @default(true)
  patientName     String?
  patientPhone    String?
  patientEmail    String?
  otherSymptoms   String?
  comment         String?
  fee             Int
  slotLock        String?           @unique
  rescheduleCount Int               @default(0)
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  payment         Payment?
  reports         FileObject[]      @relation("AppointmentReports")
  symptoms        Symptom[]         @relation("AppointmentToSymptom")

  @@index([userId, date])
  @@index([doctorId, date])
}

model HospitalBooking {
  id            String                @id @default(uuid())
  userId        String
  hospitalId    String
  doctorId      String?
  roomId        String?
  admissionDate DateTime              @db.Date
  status        HospitalBookingStatus @default(REQUESTED)
  otherSymptoms String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  doctor        Doctor?               @relation(fields: [doctorId], references: [id])
  hospital      Hospital              @relation(fields: [hospitalId], references: [id])
  room          HospitalRoom?         @relation(fields: [roomId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  payments      Payment[]
  reports       FileObject[]          @relation("HospitalBookingReports")
  symptoms      Symptom[]             @relation("HospitalBookingToSymptom")

  @@index([userId, admissionDate])
  @@index([hospitalId, admissionDate])
}

model Payment {
  id                String           @id @default(uuid())
  userId            String
  purpose           PaymentPurpose
  title             String
  amount            Int
  currency          String           @default("INR")
  status            PaymentStatus    @default(PENDING)
  provider          String?
  providerRef       String?
  appointmentId     String?          @unique
  hospitalBookingId String?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id])
  hospitalBooking   HospitalBooking? @relation(fields: [hospitalBookingId], references: [id])
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
