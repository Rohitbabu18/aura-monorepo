model Doctor {
  id                    String               @id @default(uuid())
  name                  String?
  phone                 String               @unique
  email                 String?              @unique
  role                  String?
  alternatePhone        String?
  specialization        String?
  experience            String?
  registrationNumber    String?
  registrationAuthority String?
  password              String
  avatarUrl             String?
  degree                String?
  about                 String?
  education             String?
  awards                String?
  clinicName            String?
  consultationFee       Int?
  waitingTimeMins       Int?
  services              String[]
  photoUrls             String[]
  videoUrl              String?
  isFeatured            Boolean              @default(false)
  isAuraSpecialist      Boolean              @default(false)
  isActive              Boolean              @default(true)
  ratingAvg             Float                @default(0)
  ratingCount           Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  address               Address?
  appointments          Appointment[]
  comments              Comment[]
  complaints            Complaint[]
  conversations         Conversation[]
  availability          DoctorAvailability[]
  favouritedBy          FavouriteDoctor[]
  hospitalBookings      HospitalBooking[]
  posts                 Post[]
  reviews               Review[]
  hospitals             Hospital[]           @relation("DoctorToHospital")
}

model DoctorAvailability {
  id          String @id @default(uuid())
  doctorId    String
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int    @default(15)
  doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
}

model FavouriteDoctor {
  userId    String
  doctorId  String
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, doctorId])
}
