model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json? // e.g. { appointmentId }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

// Chat with doctor / Chat with Aura
model Conversation {
  id              String           @id @default(uuid())
  type            ConversationType
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId        String?
  doctor          Doctor?          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  lastMessageText String?
  lastMessageAt   DateTime?
  userLastReadAt  DateTime?
  blockedAt       DateTime?
  messages        Message[]
  createdAt       DateTime         @default(now())

  @@unique([userId, doctorId])
  @@index([userId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Feed: "Ask a question or share a case"
model Post {
  id             String         @id @default(uuid())
  authorType     AuthorType
  authorUserId   String?
  authorUser     User?          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  authorDoctorId String?
  authorDoctor   Doctor?        @relation(fields: [authorDoctorId], references: [id], onDelete: Cascade)
  title          String
  body           String?
  visibility     PostVisibility @default(PUBLIC)
  likeCount      Int            @default(0)
  commentCount   Int            @default(0)

  tags     Speciality[]
  media    PostMedia[]
  likes    PostLike[]
  saves    PostSave[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visibility, createdAt])
}

model PostMedia {
  id       String     @id @default(uuid())
  postId   String
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileId   String
  file     FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  kind     MediaKind
  position Int        @default(0)
}

model PostLike {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model PostSave {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Comment {
  id             String     @id @default(uuid())
  postId         String
  post           Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]  @relation("CommentReplies")
  authorType     AuthorType
  authorUserId   String?
  authorUser     User?      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  authorDoctorId String?
  authorDoctor   Doctor?    @relation(fields: [authorDoctorId], references: [id], onDelete: Cascade)
  text           String
  createdAt      DateTime   @default(now())

  @@index([postId, parentId, createdAt])
}
