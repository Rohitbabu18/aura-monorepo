model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Conversation {
  id              String           @id @default(uuid())
  type            ConversationType
  userId          String
  doctorId        String?
  lastMessageText String?
  lastMessageAt   DateTime?
  userLastReadAt  DateTime?
  blockedAt       DateTime?
  createdAt       DateTime         @default(now())
  doctor          Doctor?          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([userId, doctorId])
  @@index([userId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderType     SenderType
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Post {
  id             String         @id @default(uuid())
  authorType     AuthorType
  authorUserId   String?
  authorDoctorId String?
  title          String
  body           String?
  visibility     PostVisibility @default(PUBLIC)
  likeCount      Int            @default(0)
  commentCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  comments       Comment[]
  authorDoctor   Doctor?        @relation(fields: [authorDoctorId], references: [id], onDelete: Cascade)
  authorUser     User?          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  likes          PostLike[]
  media          PostMedia[]
  saves          PostSave[]
  tags           Speciality[]   @relation("PostToSpeciality")

  @@index([visibility, createdAt])
}

model PostMedia {
  id       String     @id @default(uuid())
  postId   String
  fileId   String
  kind     MediaKind
  position Int        @default(0)
  file     FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostSave {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id             String     @id @default(uuid())
  postId         String
  parentId       String?
  authorType     AuthorType
  authorUserId   String?
  authorDoctorId String?
  text           String
  createdAt      DateTime   @default(now())
  authorDoctor   Doctor?    @relation(fields: [authorDoctorId], references: [id], onDelete: Cascade)
  authorUser     User?      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parent         Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]  @relation("CommentReplies")
  post           Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, parentId, createdAt])
}
