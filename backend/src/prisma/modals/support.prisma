model AssistantRequest {
  id             String               @id @default(uuid())
  userId         String
  type           AssistantRequestType
  status         RequestStatus        @default(OPEN)
  doctorName     String?
  hospitalName   String?
  medicineName   String?
  bloodGroup     String?
  qualification  String?
  workExperience String?
  expectedSalary String?
  details        String?
  locationText   String?
  latitude       Float?
  longitude      Float?
  attachmentId   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  attachment     FileObject?          @relation(fields: [attachmentId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Complaint {
  id             String          @id @default(uuid())
  userId         String
  target         ComplaintTarget
  doctorId       String?
  hospitalId     String?
  subjectName    String?
  city           String?
  address        String?
  clinicName     String?
  registrationNo String?
  description    String
  evidenceId     String?
  status         RequestStatus   @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  doctor         Doctor?         @relation(fields: [doctorId], references: [id])
  evidence       FileObject?     @relation(fields: [evidenceId], references: [id])
  hospital       Hospital?       @relation(fields: [hospitalId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
