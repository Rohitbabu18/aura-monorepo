model FileObject {
  id                String             @id @default(uuid())
  ownerId           String
  purpose           FilePurpose
  visibility        FileVisibility     @default(PRIVATE)
  storageKey        String             @unique
  originalName      String
  mimeType          String
  size              Int
  createdAt         DateTime           @default(now())
  assistantRequests AssistantRequest[]
  complaints        Complaint[]
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postMedia         PostMedia[]
  appointments      Appointment[]      @relation("AppointmentReports")
  hospitalBookings  HospitalBooking[]  @relation("HospitalBookingReports")

  @@index([ownerId, purpose, createdAt])
}
