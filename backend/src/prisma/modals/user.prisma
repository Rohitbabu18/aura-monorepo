model User {
  id                    String    @id @default(uuid())
  name                  String?
  phone                 String?   @unique
  email                 String?   @unique
  alternatePhone        String?
  password              String
  activeSessionId       String?
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  // Personal info (ProfilePage1 / EditPersonalInfo)
  avatarUrl            String?
  gender               Gender?
  dateOfBirth          DateTime?      @db.Date
  bloodGroup           BloodGroup?
  maritalStatus        MaritalStatus?
  heightFeet           Float?
  weightKg             Float?
  phoneVerifiedAt      DateTime?
  notificationsEnabled Boolean        @default(true)

  address       Address?
  healthProfile UserHealthProfile?

  appointments      Appointment[]
  hospitalBookings  HospitalBooking[]
  payments          Payment[]
  reviews           Review[]
  favouriteDoctors  FavouriteDoctor[]
  notifications     Notification[]
  conversations     Conversation[]
  posts             Post[]
  postLikes         PostLike[]
  postSaves         PostSave[]
  comments          Comment[]
  assistantRequests AssistantRequest[]
  complaints        Complaint[]
  feedback          Feedback[]
  files             FileObject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Medical (ProfilePage2 / EditMedicalInfo) + Lifestyle (ProfilePage3 / EditLifeStyleInfo)
model UserHealthProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  allergyType       AllergyType?
  allergyDetails    String?
  medicationStatus  HistoryStatus?
  medicationDetails String?
  diseaseStatus     HistoryStatus?
  diseaseDetails    String?
  surgeryStatus     HistoryStatus?
  surgeryDetails    String?

  smokingHabit       SmokingHabit?
  alcoholConsumption AlcoholConsumption?
  activityLevel      ActivityLevel?
  occupation         String?

  updatedAt DateTime @updatedAt
}

model OtpCode {
  id         String     @id @default(uuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}
