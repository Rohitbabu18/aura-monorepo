# --- Required ---
DATABASE_URL="postgresql://USER@127.0.0.1:5432/hospital_db"
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret

# --- Auth ---
JWT_REFRESH_SECRET=replace_with_another_long_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_VERIFICATION_EXPIRES_IN=15m
# Set to "true" only for testing: lets /api/user/register skip OTP phone verification.
ALLOW_UNVERIFIED_REGISTRATION=false

# --- Runtime ---
# NODE_ENV=production disables OTP dev codes, the mock payment provider and demo seeding.
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGIN=
# Prefix for URLs of uploaded files (e.g. https://api.example.com). Relative URLs when empty.
PUBLIC_BASE_URL=
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_MB=10
FILE_URL_TTL_SECONDS=3600
PAYMENT_HOLD_MINUTES=15

# --- Back office ---
# Enables /api/admin/* (header "x-admin-key"). Leave empty to disable.
ADMIN_API_KEY=

# --- Integrations (not implemented yet; setting these makes the endpoints return 501) ---
SMS_PROVIDER=
PAYMENT_PROVIDER=
